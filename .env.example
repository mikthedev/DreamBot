# Create an application at https://discord.com/developers/applications
# Bot → Reset Token → paste here
DISCORD_TOKEN=your_bot_token_here

# Optional: channel ID for welcome messages (right-click channel → Copy Channel ID)
# If empty, the bot tries DMs first, then the system welcome channel
WELCOME_CHANNEL_ID=

# Birthday announcements timezone and local hour (0-23)
BIRTHDAY_TIMEZONE=Europe/Kyiv
BIRTHDAY_ANNOUNCE_HOUR=10

# Free Llama AI via Groq (no billing) — https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# Optional chat model (default: llama-3.3-70b-versatile — smarter, still fast on Groq)
# GROQ_MODEL=llama-3.3-70b-versatile
# Faster / higher daily limits: llama-3.1-8b-instant
# Optional Whisper model (default: whisper-large-v3-turbo — faster for voice)
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# More accurate / slower: whisper-large-v3
# Optional force language (ru/en/uk). Empty = auto, with RU retry on wake miss.
# GROQ_WHISPER_LANGUAGE=ru
# Optional TTS (edge-tts, free) — masculine defaults
# TTS_VOICE=en-US-GuyNeural
# TTS_VOICE_RU=ru-RU-DmitryNeural
# TTS_VOICE_UK=uk-UA-OstapNeural
# TTS_RATE=+8%
# TTS_PITCH=+4Hz

# Factual questions (who is X, etc.) auto-lookup Wikipedia + DuckDuckGo — no key needed.

# Play together: leave this unset until Presence Intent is ON in
# Developer Portal → Bot → Privileged Gateway Intents. Then:
# PLAY_PRESENCE_INTENT=1
# Optional tuning; most of this is also in /panel → Play together → Settings.
# PLAY_HALF_LIFE_DAYS=7
# PLAY_DETECT_INTERVAL_HOURS=6
# PLAY_VOICE_SAMPLE_MINUTES=5
# PLAY_REMIND_MINUTES=60

