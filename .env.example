# Create an application at https://discord.com/developers/applications
# Bot → Reset Token → paste here
DISCORD_TOKEN=your_bot_token_here

# Optional: channel ID for welcome messages (right-click channel → Copy Channel ID)
# If empty, the bot tries DMs first, then the system welcome channel
WELCOME_CHANNEL_ID=

# Birthday announcements timezone and local hour (0-23)
BIRTHDAY_TIMEZONE=Europe/Kyiv
BIRTHDAY_ANNOUNCE_HOUR=10

# Optional: path to Netscape cookies.txt for YouTube (default: ./cookies.txt)
# Needed on bot-hosting when YouTube blocks datacenter IPs
# YTDLP_COOKIES=/home/container/cookies.txt

# Optional: residential HTTP/SOCKS proxy for yt-dlp (when cookies alone aren't enough)
# Must include a scheme — NOT the bot-hosting panel address.
# YTDLP_PROXY=socks5://user:pass@host:port
# YTDLP_PROXY=http://user:pass@host:port
_proxy = os.getenv("YTDLP_PROXY", "").strip()
if _proxy and "://" not in _proxy:
    # Reject values like prem-eu5.bot-hosting.cloud:20790 (panel SFTP, not a proxy)
    _proxy = ""
YTDLP_PROXY = _proxy